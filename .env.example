# Database connection (Neon PostgreSQL)
# En local y Vercel Preview, DATABASE_URL debe apuntar a la BD de DEVELOP
DATABASE_URL="postgresql://user:password@host-develop/neondb?sslmode=require"
# Opcional para scripts de sincronización (sync-prod-to-dev.js):
DATABASE_URL_PRODUCTION="postgresql://user:password@host-prod/neondb?sslmode=require"
DATABASE_URL_DEVELOP="postgresql://user:password@host-develop/neondb?sslmode=require"

# NextAuth Secret (generar con `openssl rand -hex 32` o `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Asignar un hash exclusivo para Production en Vercel, y otro diferente para Preview y Development
AUTH_SECRET="tu_auth_secret_para_desarrollo_o_preview"
# AUTH_SECRET_PROD="tu_auth_secret_exclusivo_para_produccion"
NEXTAUTH_URL="http://localhost:3000"

# Web Push VAPID Keys (generar con `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="tu_vapid_public_key_aqui"
VAPID_PRIVATE_KEY="tu_vapid_private_key_aqui"
VAPID_SUBJECT="mailto:admin@cinv.org"
